@model MyPortfolio.Models.Project
@{
    ViewData["Title"] = Model.Title;
    Layout = "_HeroLayout";
}

<div class="container py-5 hero-details">
    <a asp-controller="Home" asp-action="Index">&larr; Back to portfolio</a>

    <h1 class="mt-3">@Model.Title</h1>
    <img src="@Model.ThumbnailPath" style="max-width:500px" class="img-fluid rounded mb-3" alt="@Model.Title" />
    <p>@Model.Description</p>
    <a href="@Model.GitHubUrl" target="_blank" class="btn">View on GitHub</a>

    <hr />
    <h3>Comments</h3>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Projects" asp-action="AddComment" method="post">
            <input type="hidden" name="projectId" value="@Model.Id" />
            <input name="author" placeholder="Your name" class="form-control mb-2" />
            <textarea name="text" placeholder="Add a comment..." class="form-control mb-2" required></textarea>
            @Html.AntiForgeryToken()
            <button type="submit" class="btn">Post Comment</button>
        </form>
    }
    else
    {
        <p><a asp-controller="Account" asp-action="Login">Log in</a> to leave a comment.</p>
    }

    <ul class="list-group mt-3">
        @foreach (var c in Model.Comments.OrderByDescending(c => c.CreatedAt))
        {
            <li class="list-group-item">
                <strong>@c.Author</strong> — @c.CreatedAt.ToString("g")
                <p class="mb-0">@c.Text</p>
            </li>
        }
    </ul>
</div>