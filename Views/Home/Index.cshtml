@{
    ViewData["Title"] = "Home";
    Layout = "_HeroLayout";
}

<section class="hero">
    <div class="hero-photo-wrap">
        <div class="hero-photo">
            <img src="~/images/profile.png" alt="Profile photo" />
        </div>
    </div>
    <div class="hero-text">
        <p class="hero-greeting">Hi I am</p>
        <h2 class="hero-name">Roque Kevin Clerck</h2>
        <h1 class="hero-title">IT <span class="hero-accent">Student</span> &amp;<br />Developer</h1>
        <p class="hero-desc">
            BSIT student building web apps with ASP.NET Core MVC.
            Check out the projects I've built so far.
        </p>
        <a asp-controller="Home" asp-action="Portfolio" class="btn btn-hire">View Portfolio</a>
        <div class="hero-socials">
            <a href="https://www.linkedin.com/in/kevin-clerck-roque-a82904422/" target="_blank"><i class="bi bi-linkedin"></i></a>
            <a href="https://github.com/KevinRoque1" target="_blank"><i class="bi bi-github"></i></a>
        </div>
    </div>
</section>